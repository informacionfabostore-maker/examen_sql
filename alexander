PRAGMA foreign_keys = ON;

-- 1. AUTORES
CREATE TABLE Autores (
    id_autor INTEGER PRIMARY KEY,
    nombre TEXT NOT NULL,
    fecha_nacimiento TEXT NOT NULL,
    nacionalidad TEXT NOT NULL
);

-- 2. LIBROS
CREATE TABLE Libros (
    id_libro INTEGER PRIMARY KEY,
    titulo TEXT NOT NULL,
    editorial TEXT NOT NULL,
    categoria TEXT NOT NULL,
    fecha_publicacion TEXT NOT NULL,
    isbn TEXT NOT NULL UNIQUE,
    precio NUMERIC NOT NULL CHECK (precio > 0),
    stock INTEGER NOT NULL DEFAULT 0
        CHECK (stock >= 0)
);

-- 3. RELACION LIBROS - AUTORES
CREATE TABLE LibroAutor (
    id_libro INTEGER NOT NULL,
    id_autor INTEGER NOT NULL,

    PRIMARY KEY (id_libro, id_autor),

    FOREIGN KEY (id_libro)
        REFERENCES Libros(id_libro),

    FOREIGN KEY (id_autor)
        REFERENCES Autores(id_autor)
);

-- 4. CLIENTES
CREATE TABLE Clientes (
    id_cliente INTEGER PRIMARY KEY,
    nombre TEXT NOT NULL,
    correo TEXT NOT NULL UNIQUE,
    telefono TEXT,
    direccion TEXT NOT NULL
);

-- 5. PEDIDOS

CREATE TABLE Pedidos (

    id_pedido INTEGER PRIMARY KEY,

    id_cliente INTEGER NOT NULL,

    fecha_compra TEXT NOT NULL,

    estado TEXT NOT NULL DEFAULT 'pendiente'

        CHECK (estado IN (

            'pendiente',

            'procesado',

            'completado'

        )),

    FOREIGN KEY (id_cliente)

        REFERENCES Clientes(id_cliente)

);

-- 6. DETALLE DE PEDIDO

CREATE TABLE DetallePedido (

    id_detalle INTEGER PRIMARY KEY,

    id_pedido INTEGER NOT NULL,

    id_libro INTEGER NOT NULL,

    cantidad INTEGER NOT NULL CHECK (cantidad > 0),

    precio_unitario NUMERIC NOT NULL

        CHECK (precio_unitario > 0),

    UNIQUE (id_pedido, id_libro),

    FOREIGN KEY (id_pedido)

        REFERENCES Pedidos(id_pedido),

    FOREIGN KEY (id_libro)

        REFERENCES Libros(id_libro)

);

-- 7. TRANSACCIONES

CREATE TABLE Transacciones (

    id_transaccion INTEGER PRIMARY KEY,

    id_pedido INTEGER NOT NULL UNIQUE,

    metodo_pago TEXT NOT NULL,

    monto_total NUMERIC NOT NULL

        CHECK (monto_total >= 0),

    fecha_transaccion TEXT NOT NULL,

    FOREIGN KEY (id_pedido)

        REFERENCES Pedidos(id_pedido)

);

-- 8. VALIDAR STOCK ANTES DE VENDER

CREATE TRIGGER validar_stock

BEFORE INSERT ON DetallePedido

BEGIN

    SELECT RAISE(ABORT, 'Stock insuficiente')

    WHERE (

        SELECT stock

        FROM Libros

        WHERE id_libro = NEW.id_libro

    ) < NEW.cantidad;

END;

-- 9. DESCONTAR STOCK AUTOMATICAMENTE

CREATE TRIGGER descontar_stock

AFTER INSERT ON DetallePedido

BEGIN

    UPDATE Libros

    SET stock = stock - NEW.cantidad

    WHERE id_libro = NEW.id_libro;

END;
